# Copie este arquivo para .env. Não versione credenciais.

# Configura a conexão AMQP com o RabbitMQ disponível na máquina local.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Compartilha o segredo do webhook; usa o ambiente ou o valor de demonstração.
WEBHOOK_SECRET=segredo-local-trabalho3

# Aponta para a API local do Estoque consultada pelo Gateway.
ESTOQUE_URL=http://127.0.0.1:8001

# Aponta para a API local do provedor simulado de cobrança.
MOCK_URL=http://127.0.0.1:8003

# Gera URLs de checkout que o navegador do usuário consegue abrir.
MOCK_PUBLIC_URL=http://localhost:8003

# Define o endpoint local onde Pagamento receberá a decisão do Mock.
WEBHOOK_URL=http://127.0.0.1:8002/webhook

# Define o intervalo em segundos entre campanhas promocionais.
INTERVALO_PROMOCOES=30

# arquivo = demonstração em SQLite/log, sem envio real

# resend = API externa real; exige chave e remetente autorizado

# Seleciona arquivo para demonstração local ou resend para envio real.
EMAIL_MODO=arquivo

# Obtém a chave do Resend do ambiente, mantendo-a fora do repositório.
RESEND_API_KEY=

# Configura o remetente, que deve ser autorizado pelo provedor de e-mail.
EMAIL_FROM=E-commerce UTFPR <onboarding@resend.dev>
